# AgriGPT AI Service Environment Configuration
# Copy this to .env for local development

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Service Authentication (Shared secret between Next.js BFF and FastAPI)
# Generate via: openssl rand -hex 32
SERVICE_SHARED_SECRET=development_shared_secret_min_32_chars_long

# Open Government Data (OGD) India API
# Register at: https://data.gov.in
# Resource: Current Daily Price of Various Commodities from Various Markets (Mandi)
OGD_API_KEY=
OGD_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
OGD_TIMEOUT_SECONDS=4.0

# Weather Provider Configuration
# Open-Meteo is used as primary NWP provider (CC BY 4.0 Attribution required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=4.0

# IMD Enterprise Provider (Pending formal MoU & Static IP whitelisting by IMD Nodal Officer)
IMD_API_ENABLED=false
IMD_API_BASE_URL=https://api.imd.gov.in

# Supabase / PostgreSQL Persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
