# ==========================================
# AgriGPT Root .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secret Protection
# ------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Allow example configuration templates
!.env.example
!**/.env.example
!.env*.example
!**/.env*.example

# Private keys and certificates
*.pem
*.key
*.cert
*.pfx
id_rsa*

# ------------------------------------------
# Node.js & Next.js (frontend)
# ------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
build/
**/build/
.vercel
**/.vercel
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------
# Python (ai_service)
# ------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual Environments
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/
**/env/
**/ENV/

# ------------------------------------------
# Local Databases & Storage
# ------------------------------------------
*.db
*.sqlite
*.sqlite3

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# Operating System & IDE Artifacts
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
