# AgriGPT Frontend Environment Configuration
# Copy this to .env.local for local development

# FastAPI Backend Service URL (Server-to-server internal proxy)
AI_SERVICE_URL=http://127.0.0.1:8000

# Shared secret for internal server-to-server API authentication
INTERNAL_SERVICE_KEY=development_shared_secret_min_32_chars_long

# Iron session encryption secret (32+ characters)
SESSION_SECRET=agrigpt_dev_session_secret_change_in_production_32char

# Node Environment
NODE_ENV=development
